PORT=8082
JWT_SECRET=reemplaza-esto-por-un-secreto-largo-y-unico
RESET_DEMO_ADMIN=false
DB_SERVER=.\\MSSQLSERVER02
DB_NAME=TiendaRopa
# Usa la sesión actual de Windows (como en SQL Server Management Studio).
DB_WINDOWS_AUTH=true
DB_TRUST_SERVER_CERTIFICATE=true
# Si TCP está deshabilitado en la instancia local, puedes usar la canalización nombrada:
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=np:\\.\pipe\MSSQL$MSSQLSERVER02\sql\query;Database=TiendaRopa;Trusted_Connection=Yes;TrustServerCertificate=Yes

# Si se usa autenticación de SQL Server, cambia DB_WINDOWS_AUTH a false y completa:
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=tu_contrasena